# PostgreSQL
POSTGRES_DB=english_center
POSTGRES_USER=english_center
POSTGRES_PASSWORD=change-this-database-password

# Backend
DATABASE_URL=postgresql://english_center:change-this-database-password@database:5432/english_center?schema=public
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:8080
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_REFRESH_DAYS=7
ADMIN_EMAIL=admin@your-center.local
ADMIN_PASSWORD=replace-this-admin-password

# Frontend (browser requests stay on the same domain through Nginx)
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SITE_URL=http://localhost:8080
PLAYWRIGHT_BASE_URL=http://localhost:8080

# Tài khoản demo giai đoạn 3 - bắt buộc đổi trước production
DEMO_PASSWORD=replace-this-demo-password
TEACHER_EMAIL=teacher@your-center.local
STUDENT_EMAIL=student@your-center.local

# Upload/import hardening
UPLOAD_MAX_FILE_MB=15
UPLOAD_MAX_BATCH_MB=50
UPLOAD_MAX_IMAGE_FILES=20
UPLOAD_MAX_PDF_PAGES=300
UPLOAD_MAX_IMAGE_PIXELS=25000000
UPLOAD_MAX_UNCOMPRESSED_MB=100
UPLOAD_MAX_ARCHIVE_ENTRIES=2000
UPLOAD_MAX_SHEETS=10
UPLOAD_MAX_ROWS=10000
UPLOADS_PER_USER_PER_HOUR=20
UPLOAD_TOTAL_QUOTA_MB=10240
UPLOAD_USER_QUOTA_MB=2048
IMPORT_WORKER_ENABLED=true
IMPORT_POLL_INTERVAL_MS=1500
IMPORT_TIMEOUT_MS=180000
AI_IMPORT_ENABLED=true
# Create a key in Google AI Studio. Keep this value on the backend only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=minimal
AI_IMPORT_TIMEOUT_MS=120000
AI_IMPORT_MAX_OUTPUT_TOKENS=65536
AI_IMPORT_MAX_INLINE_MB=14
AI_IMPORT_PAGES_PER_REQUEST=2
AI_IMPORT_PAGE_OVERLAP=1
AI_IMPORT_QUOTA_COOLDOWN_MS=1800000
AI_IMPORT_REVIEW_ENABLED=true
GEMINI_REVIEW_MODEL=gemini-3.5-flash-lite
SOURCE_RETENTION_DAYS=30
CLAMAV_REQUIRED=true
CLAMAV_TIMEOUT_MS=30000
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# Google Drive API upload is not wired in this MVP; paste shared links in the teacher dashboard instead.
# Reserved for a future integration (these variables currently have no runtime effect).
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

